---
// The tour: five steps, each a claim with its measured fact, beside the still
// model whose camera frames the part each step is about.
import { Container, Fact, Heading, TextLink } from '@tosak/design';
import { count, dayMonth, minutes, numbers } from '../numbers/index.ts';
import TourCamera from '../tour/TourCamera.tsx';
import { buildArticle } from '../links.ts';
import TourStep from './TourStep.astro';
import styles from './Tour.module.css';

const { checks, applications, releases, decisions, drill, rehearsedAt } = numbers;
---

<Container as="section" id="parts" className={styles.tour} aria-labelledby="parts-title">
  <Heading level={2} id="parts-title">
    Built to be rebuilt.
  </Heading>
  <div class={styles.grid} data-tour>
    <ol class={styles.steps}>
      <TourStep focus="machines" title="Self-hosted Kubernetes, no managed service.">
        <p>Every app I ship runs here. I built it on plain cloud servers, and I run it myself.</p>
        <Fact>
          Every public address is checked each minute through Cloudflare, the way a visitor reaches
          it: <b>{count(checks.total)}</b> checks since {dayMonth(checks.since)},{' '}
          <b>{count(checks.failed)}</b> failed.
        </Fact>
      </TourStep>
      <TourStep focus="road" title="Fully GitOps: Git decides what runs.">
        <p>
          Nobody changes the cluster by hand. Every change is a pull request, and once it merges,
          Argo&nbsp;CD makes the cluster match Git. A rollback is a revert.
        </p>
        <Fact>
          <b>
            {applications.matchGit} of {applications.total}
          </b>{' '}
          apps match Git. <b>{releases.count}</b> releases since {dayMonth(releases.since)}.
        </Fact>
      </TourStep>
      <TourStep focus="all" title="Every step is written down.">
        <p>
          Every decision has a dated record with its reason, and every step of the build is in a
          runbook. All of it is public.
        </p>
        <Fact>
          <b>{decisions}</b> recorded decisions.{' '}
          <TextLink href={buildArticle}>Read how it is built</TextLink>
        </Fact>
      </TourStep>
      <TourStep focus="drill" title="Backups are tested, not trusted.">
        <p>
          A full backup leaves the cluster every day. On the 1st of each month, a drill restores it
          into a throwaway database and checks the data.
        </p>
        <Fact>
          <b>{minutes(drill.minutes)}</b>, {drill.passed ? 'passed' : 'failed'}, on{' '}
          {dayMonth(drill.ranAt)}. Next drill: {dayMonth(drill.next)}.
        </Fact>
      </TourStep>
      <TourStep focus="all" title="Rebuildable from scratch, with one command.">
        <p>
          kluster, the Go CLI I wrote, is where all of this leads. From an empty cloud project, one
          command builds the servers, installs every part from Git and restores the data.
        </p>
        <Fact>
          Rehearsed end to end in a separate project on <b>{dayMonth(rehearsedAt)}</b>.
        </Fact>
      </TourStep>
    </ol>
    <div class={styles.picture}>
      <TourCamera client:visible />
    </div>
  </div>
</Container>
