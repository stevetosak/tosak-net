---
// The tour: five steps, each a claim with its measured fact, beside the still
// model whose camera frames the part each step is about.
import { Container, Fact, Heading, TextLink } from '@tosak/design';
import {
  count,
  dayMonth,
  daysBetween,
  duration,
  lastDays,
  minutes,
  numbers,
  passedPercent,
  percent,
  rebuild,
} from '../numbers/index.ts';
import TourCamera from '../tour/TourCamera.tsx';
import { buildArticle, docs } from '../links.ts';
import TourStep from './TourStep.astro';
import styles from './Tour.module.css';

const { availability, offsiteCopy, drill } = numbers;
const checkedDays = lastDays(daysBetween(availability.from, availability.to));
const copyDays = lastDays(daysBetween(offsiteCopy.from, offsiteCopy.to));
const failedUploads =
  offsiteCopy.failedUploads === 1 ? '1 upload' : `${count(offsiteCopy.failedUploads)} uploads`;
---

<Container as="section" id="parts" className={styles.tour} aria-labelledby="parts-title">
  <Heading level={2} id="parts-title">
    Built to be rebuilt.
  </Heading>
  <div class={styles.grid} data-tour>
    <ol class={styles.steps}>
      <TourStep focus="machines" title="Self-hosted Kubernetes, no managed service.">
        <p>Every app I ship runs here. I built it on plain cloud servers, and I run it myself.</p>
        <Fact>
          Every public address is checked each minute through Cloudflare, the way a visitor reaches
          it: <b>{percent(passedPercent(availability.checks, availability.failed))}</b> of{' '}
          {count(availability.checks)} checks passed over {checkedDays}.
        </Fact>
      </TourStep>
      <TourStep focus="road" title="Fully GitOps: Git decides what runs.">
        <p>
          Nobody changes the cluster by hand. Every change is a pull request, and once it merges,
          Argo&nbsp;CD makes the cluster match Git. A rollback is a revert.
        </p>
      </TourStep>
      <TourStep focus="all" title="Every step is written down.">
        <p>
          Every decision has a dated record with its reason, and every step of the build is in a
          runbook. All of it is public.
        </p>
        <Fact>
          <TextLink href={buildArticle}>Read how it is built</TextLink>, and{' '}
          <TextLink href={docs}>every decision with its reason</TextLink>.
        </Fact>
      </TourStep>
      <TourStep focus="drill" title="Backups are tested, not trusted.">
        <p>
          A full backup leaves the cluster every day, and every change follows it within minutes. On
          the 1st of each month, a drill restores it into a throwaway database and checks the data.
        </p>
        <Fact>
          {drill.passed && drill.restoreSeconds !== null ? (
            <>
              Restored and checked in <b>{duration(drill.restoreSeconds)}</b>, passed, on{' '}
              {dayMonth(drill.finishedAt)}.
            </>
          ) : (
            <>
              The drill <b>failed</b> on {dayMonth(drill.finishedAt)}.
            </>
          )}{' '}
          Next drill: {dayMonth(drill.next)}. The offsite copy was never more than{' '}
          <b>{duration(offsiteCopy.maxLagSeconds)}</b> behind over {copyDays}, with {failedUploads}{' '}
          failed.
        </Fact>
      </TourStep>
      <TourStep focus="all" title="Rebuildable from scratch, with one command.">
        <p>
          kluster, the Go CLI I wrote, is where all of this leads. From an empty cloud project, one
          command builds the servers, installs every part from Git and restores the data.
        </p>
        <Fact>
          <b>{minutes(rebuild.minutes)}</b> from an empty project to every service running,
          rehearsed on {dayMonth(rebuild.rehearsedOn)} with a fresh database.{' '}
          <TextLink href={rebuild.log}>Read the rehearsal</TextLink>
        </Fact>
      </TourStep>
    </ol>
    <div class={styles.picture}>
      <TourCamera client:visible />
    </div>
  </div>
</Container>
