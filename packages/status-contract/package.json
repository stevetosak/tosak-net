{
  "name": "@tosak/status-contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The contract of tosak-status: one JSON Schema, and the TypeScript types generated from it.",
  "exports": {
    ".": "./src/index.ts",
    "./schema.json": "./schema/status.schema.json",
    "./validate": "./src/validate.ts"
  },
  "scripts": {
    "types": "node scripts/emit-types.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
